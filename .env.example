# =============================================================================
# LOCAL MODE — run without any external services
# =============================================================================
# Set LOCAL_MODE=true for a fully self-contained deployment using SQLite,
# in-memory task queue, and local auth (no Google OAuth / Gmail / Redis /
# PostgreSQL required). Secrets are auto-generated at startup.
#
# Quick start:
#   bash scripts/setup-local.sh
#   source .venv/bin/activate
#   uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

LOCAL_MODE=false

# =============================================================================
# DATABASE
# =============================================================================
# When using docker-compose, these values are read from environment variables
# with safe defaults.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER:-expense}:${POSTGRES_PASSWORD:-expense}@localhost:5432/${POSTGRES_DB:-expense_tracker}

# For local SQLite dev (no Docker needed):
# DATABASE_URL=sqlite+aiosqlite:///./data/expense.db

# =============================================================================
# GOOGLE OAUTH (not needed when LOCAL_MODE=true)
# =============================================================================
# Create at https://console.cloud.google.com/ → APIs & Services → Credentials
# These are only required when LOCAL_MODE=false.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# =============================================================================
# SECURITY KEYS (auto-generated in LOCAL_MODE)
# =============================================================================
# In LOCAL_MODE these are auto-generated. If running without LOCAL_MODE,
# you must set them manually.

# SECRET_KEY — session signing key (min 32 characters)
SECRET_KEY=change-me-in-production

# FERNET_KEY — encryption for TOTP secrets and OAuth tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT RSA key pair — required for mobile (Bearer) auth
# Generate with: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_OLD=  # Previous public key during rotation (optional)

# =============================================================================
# OPTIONAL — defaults are usually fine
# =============================================================================

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=expense_tracker

# Database connection pool (PostgreSQL only; ignored for SQLite)
DB_POOL_SIZE=20            # Number of persistent connections in the pool
DB_MAX_OVERFLOW=30         # Max extra connections allowed beyond pool_size
DB_POOL_TIMEOUT=30         # Seconds to wait for a connection before raising
DB_POOL_RECYCLE=1800       # Seconds before a connection is recycled (30 min)
DB_POOL_PRE_PING=true      # Verify connection freshness before using from pool

# Classification tuning
LLM_CONFIDENCE_THRESHOLD=0.85   # rule confidence below this → LLM is called
AUTO_CONFIRM_THRESHOLD=0.75     # confidence above this → auto-confirmed, skips review queue

# Sync schedule
SYNC_INTERVAL_HOURS=2

# Set to true in production with HTTPS
COOKIE_SECURE=true

# Comma-separated allowed CORS origins, e.g. https://yourdomain.com
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Redis (required for task queue)
REDIS_URL=
WORKER_COUNT=10

# Optional private-beta gate. When set, onboarding requires this code.
INVITE_CODE=

# =============================================================================
# OPTIONAL — LLM provider (FreeLLMAPI trial proxy)
# =============================================================================
# Built-in env-var providers have been removed. All LLM providers come from
# BYOK (users configure their own API keys) or the FreeLLMAPI trial proxy.
#
# FreeLLMAPI is a hosted proxy that provides free LLM access for trial users.
# The app owner (OWNER_EMAIL) gets permanent FreeLLMAPI access.

FREELLMAPI_API_KEY=              # Shared proxy key for FreeLLMAPI
FREELLMAPI_BASE_URL=https://your-llm-proxy.example.com
FREELLMAPI_MODEL=                # empty = proxy auto-selects
ENABLE_LLM_TRIAL=false           # Enable 7-day free trial for new users
OWNER_EMAIL=                     # Gets permanent FreeLLMAPI access

#
# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
#
# Before deploying to production, verify:
#   □ SECRET_KEY is set to a long random value (min 32 chars)
#   □ JWT_PRIVATE_KEY and JWT_PUBLIC_KEY are set (generate RSA-2048 key pair)
#   □ FERNET_KEY is set (generate with the command above)
#   □ COOKIE_SECURE=true (requires HTTPS)
#   □ CORS_ORIGINS is set to your production domain(s)
#   □ POSTGRES_PASSWORD is a strong unique password
#   □ DATABASE_URL points to your production PostgreSQL database
#   □ Dedup preflight script has been run before migration 0040:
#        python -m app.scripts.dedup_before_migration --dry-run
