# =============================================================================
# REQUIRED — app will not start without these
# =============================================================================

# Database
# When using docker-compose, these values are read from environment variables
# with safe defaults. Override by setting them in your .env file.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER:-expense}:${POSTGRES_PASSWORD:-expense}@localhost:5432/${POSTGRES_DB:-expense_tracker}
# For local SQLite dev (no Docker needed):
# DATABASE_URL=sqlite+aiosqlite:///./data/expense.db

# Google OAuth — Gmail API access
# Create at https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# =============================================================================
# REQUIRED for production deployments (min 32 chars each)
# =============================================================================

# Security — change this in production (min 32 characters)
SECRET_KEY=change-me-in-production

# Fernet encryption key — used for encrypting TOTP secrets and OAuth tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT secret — required for mobile (Bearer) auth; set a long random value (min 32 characters)
JWT_SECRET=

# =============================================================================
# OPTIONAL — defaults are usually fine
# =============================================================================

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=expense_tracker

# Database connection pool (PostgreSQL only; ignored for SQLite)
DB_POOL_SIZE=5             # Number of persistent connections in the pool
DB_MAX_OVERFLOW=10         # Max extra connections allowed beyond pool_size
DB_POOL_TIMEOUT=30         # Seconds to wait for a connection before raising
DB_POOL_RECYCLE=1800       # Seconds before a connection is recycled (30 min)

# OpenRouter model (only used when OPENROUTER_API_KEY is set)
LLM_MODEL=google/gemini-2.0-flash-exp:free

# Classification tuning
LLM_CONFIDENCE_THRESHOLD=0.85   # rule confidence below this → LLM is called
AUTO_CONFIRM_THRESHOLD=0.75     # confidence above this → auto-confirmed, skips review queue

# Sync schedule
SYNC_INTERVAL_HOURS=2

# Set to true in production with HTTPS
COOKIE_SECURE=true

# Comma-separated allowed CORS origins, e.g. https://yourdomain.com
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional private-beta gate. When set, onboarding requires this code.
INVITE_CODE=

# =============================================================================
# OPTIONAL — add at least one for LLM-based classification
# =============================================================================

# LLM providers — add at least one key
# Priority order: Groq → Google → Grok → Scaleway → OpenRouter
# Rate-limited providers are automatically demoted; others take over seamlessly

GROQ_API_KEY=            # Groq (Llama 3.3 70B)            https://console.groq.com/
GOOGLE_AI_API_KEY=        # Gemini 2.0 Flash (free tier)  https://aistudio.google.com/apikey
GROK_API_KEY=             # xAI Grok 3 Mini               https://console.x.ai/
SCALEWAY_API_KEY=         # Llama 3.3 70B                 https://console.scaleway.com/
OPENROUTER_API_KEY=       # Any model via OpenRouter       https://openrouter.ai/keys

#
# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
#
# Before deploying to production, verify:
#   □ SECRET_KEY is set to a long random value (min 32 chars)
#   □ JWT_SECRET is set to a long random value (min 32 chars)
#   □ FERNET_KEY is set (generate with the command above)
#   □ COOKIE_SECURE=true (requires HTTPS)
#   □ CORS_ORIGINS is set to your production domain(s)
#   □ POSTGRES_PASSWORD is a strong unique password
#   □ DATABASE_URL points to your production PostgreSQL database
#   □ Dedup preflight script has been run before migration 0040:
#        python -m app.scripts.dedup_before_migration --dry-run
