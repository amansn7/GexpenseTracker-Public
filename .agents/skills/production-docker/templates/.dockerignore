# =============================================================================
# Production .dockerignore
# Excludes everything that should not be in the Docker build context
# =============================================================================

# Version control
.git
.gitignore

# Environment and secrets — NEVER send to Docker daemon
.env
.env.*
!.env.example

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv
.mypy_cache
.ruff_cache
.pytest_cache
.coverage
htmlcov/
*.egg-info/

# Node.js
node_modules
.npm
.yarn

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Tests and docs (not needed in production image)
tests/
test/
docs/
*.md
!README.md

# Docker files (prevent recursive builds)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# OS files
.DS_Store
Thumbs.db
