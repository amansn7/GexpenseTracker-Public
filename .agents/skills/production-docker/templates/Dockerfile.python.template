# syntax=docker/dockerfile:1

# =============================================================================
# Production Python Dockerfile
# Multi-stage build: builder (python:3.12-slim) -> runtime (distroless)
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Builder — install dependencies in a throwaway image
# ---------------------------------------------------------------------------
FROM python:3.12-slim@sha256:da2d7af143dab7c714e0a20bdf3ab8b443997f1bcd1b78c82ac4433c40241f19 AS builder

WORKDIR /build

# Install system dependencies needed for building wheels (if any)
# Combine into one RUN and clean up to minimize layer size
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only dependency manifest first to maximize layer caching
COPY requirements.txt .

# Install Python dependencies into a prefix directory for clean copy
# --no-cache-dir: do not store pip cache in the layer
# --no-compile:   skip .pyc generation (distroless handles this at runtime)
# --prefix:       install into a separate directory for clean COPY later
RUN pip install \
    --no-cache-dir \
    --no-compile \
    --prefix=/install \
    -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: Runtime — minimal distroless image
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/python3-debian12@sha256:e8e51f1ef4a8c0a569e5e21d1684da40cab69fb0e1dae41e5e04a059ab738dee AS runtime

# OCI standard labels
LABEL org.opencontainers.image.title="myapp" \
      org.opencontainers.image.description="Production Python application" \
      org.opencontainers.image.vendor="YourOrg" \
      org.opencontainers.image.source="https://github.com/yourorg/myapp" \
      org.opencontainers.image.licenses="MIT"

# Copy installed Python packages from builder
COPY --from=builder /install/lib/python3.12/site-packages /usr/lib/python3.12/site-packages

# Copy application code, owned by the nonroot user (UID 65532)
COPY --chown=65532:65532 ./app /app

WORKDIR /app

# Distroless ships with a nonroot user at UID 65532
# This prevents container-escape-to-root attacks
USER 65532

# Expose the application port (adjust as needed)
EXPOSE 8000

# Health check — uses Python stdlib since curl/wget are not available in distroless
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]

# Use exec form for proper signal handling
ENTRYPOINT ["python", "-m", "app.main"]
