# syntax=docker/dockerfile:1

# =============================================================================
# Production Node.js Dockerfile
# Multi-stage build: builder (node:22-slim) -> runtime (node:22-slim)
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Builder — install deps and compile
# ---------------------------------------------------------------------------
FROM node:22-slim@sha256:REPLACE_WITH_CURRENT_DIGEST AS builder

WORKDIR /build

# Copy dependency manifests first (layer caching)
COPY package.json package-lock.json ./

# Install ALL dependencies (including devDependencies for build)
# --ignore-scripts: prevent postinstall scripts during build
RUN npm ci --ignore-scripts

# Copy source code
COPY . .

# Build the application (TypeScript compile, bundling, etc.)
RUN npm run build

# Remove devDependencies for production
RUN npm prune --production

# ---------------------------------------------------------------------------
# Stage 2: Runtime — minimal production image
# ---------------------------------------------------------------------------
FROM node:22-slim@sha256:REPLACE_WITH_CURRENT_DIGEST AS runtime

# Install tini for proper signal handling (PID 1 problem)
RUN apt-get update && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

# OCI standard labels
LABEL org.opencontainers.image.title="myapp" \
      org.opencontainers.image.description="Production Node.js application" \
      org.opencontainers.image.vendor="YourOrg" \
      org.opencontainers.image.source="https://github.com/yourorg/myapp" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

# Copy production dependencies and built application
COPY --from=builder --chown=node:node /build/node_modules ./node_modules
COPY --from=builder --chown=node:node /build/dist ./dist
COPY --from=builder --chown=node:node /build/package.json ./

# Run as non-root user (node user is built into the base image)
USER node

# Expose the application port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["node", "-e", "fetch('http://localhost:3000/health').then(r => { if (!r.ok) process.exit(1) })"]

# Use tini as PID 1 for proper signal forwarding
ENTRYPOINT ["tini", "--"]

# Start the application
CMD ["node", "dist/index.js"]
